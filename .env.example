# ==========================================
# Anchor Fitness OS - Production Environment
# ==========================================

# Google Gemini AI Assistant Key (Client & Backend)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Google OAuth 2.0 Client ID (GIS Authentication)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# USDA FoodData Central API Key (Nutrition Intelligence)
VITE_USDA_API_KEY=DEMO_KEY

# JWT Authentication Secrets (Dual-Token Architecture)
JWT_SECRET=super_secret_jwt_hmac_signing_key_replace_in_production
REFRESH_TOKEN_SECRET=super_secret_refresh_token_hmac_key_replace_in_production

# Server Configuration
PORT=5001
SERVER_PORT=5001
NODE_ENV=production
CORS_ORIGIN=http://localhost:5173

# SQLite Persistent Database Directory (Mount volume here in Docker)
DB_DIR=/app/data
